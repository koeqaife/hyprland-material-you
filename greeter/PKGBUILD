pkgname=hypryou-greeter
pkgver=1.0
pkgrel=1
pkgdesc="Greetd config for hypryou greeter"
arch=('any')
license=('custom')
depends=('greetd')
install="${pkgname}.install"
source=('config.toml')
sha256sums=('SKIP')

package() {
    install -Dm644 "${srcdir}/config.toml" "${pkgdir}/usr/share/${pkgname}/config.toml"
}
